# ============================================================
#  Хороший полицейский — версия для мессенджера MAX
#  Скопируйте в .env и заполните. .env не коммитить!
# ============================================================

# --- MAX ---
# Токен бота от @MasterBot в MAX
MAX_BOT_TOKEN=
# Закрытый чат модераторов: туда приходят карточки на одобрение.
# Узнать id: добавьте бота в чат и отправьте /chatid
MAX_MODERATOR_CHAT_ID=
# Канал MAX, куда публикуются одобренные посты (бот должен быть админом)
MAX_PUBLISH_CHAT_ID=
# Идентификаторы администраторов через запятую.
# Свой id человек узнаёт командой /whoami в этом боте.
MAX_ADMIN_IDS=

# --- AI Provider (OpenAI-совместимый) ---
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=https://aiprovider.duckdns.org/v1
AI_PROVIDER_MODEL=claude-sonnet-4-6
AI_PROVIDER_VERIFY_MODEL=

# --- ИИ-помощник ---
ASSISTANT_ENABLED=true
ASSISTANT_MODEL=
ASSISTANT_DAILY_LIMIT=15

# --- Изображения ---
IMAGE_GENERATION_ENABLED=true
IMAGE_CARD_FALLBACK=true

# --- Подпись под постами (ссылки ведут на max.ru/<имя>) ---
CHANNEL_USERNAME=mvd
BOT_USERNAME=kindpolice_bot
CHANNEL_TITLE=Хороший полицейский

# --- Сбор ---
FETCH_LIMIT=10
FETCH_PER_SOURCE=20
MAX_NEWS_AGE_DAYS=7
POST_INTERVAL_MINUTES=120

# --- Веб-панель модерации (необязательна) ---
PANEL_USERNAME=
PANEL_PASSWORD=

# --- Логи ---
LOG_LEVEL=INFO
LOG_TO_FILE=true
