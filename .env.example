# ============================================================
#  Хороший полицейский — версия для мессенджера MAX
#  Скопируйте в .env и заполните. .env не коммитить!
# ============================================================

# --- MAX ---
# Токен бота от @MasterBot в MAX
MAX_BOT_TOKEN=
# Закрытый чат модераторов: туда приходят карточки на одобрение.
# Узнать id: добавьте бота в чат и отправьте /chatid
MAX_MODERATOR_CHAT_ID=
# Канал MAX, куда публикуются одобренные посты (бот должен быть админом)
MAX_PUBLISH_CHAT_ID=
# Идентификаторы администраторов через запятую.
# Свой id человек узнаёт командой /whoami в этом боте.
MAX_ADMIN_IDS=

# --- AI Provider (OpenAI-совместимый) ---
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=https://aiprovider.duckdns.org/v1
AI_PROVIDER_MODEL=claude-sonnet-4-6
AI_PROVIDER_VERIFY_MODEL=

# --- ИИ-помощник ---
ASSISTANT_ENABLED=true
ASSISTANT_MODEL=
ASSISTANT_DAILY_LIMIT=15

# --- Иллюстрации к постам ---
# Порядок всегда такой: фото (или видео) из официального источника →
# генерация изображения по смыслу новости → фирменная карточка.
IMAGE_GENERATION_ENABLED=true
IMAGE_CARD_FALLBACK=true

# Сервис генерации картинок. У текстового провайдера (api.baza-ai.org)
# эндпоинта /images/generations НЕТ — проверено, отвечает 404. Поэтому
# для картинок указывается отдельный сервис и отдельный ключ. Если ключ
# не задан, используется AI_PROVIDER_API_KEY.
#
# Адрес ниже проверен вживую 10.11.2026: ProxyAPI, оплата в рублях,
# работает с сервера в РФ без VPN. Для прямого доступа к OpenAI —
# https://api.openai.com/v1
IMAGE_API_BASE=https://api.proxyapi.ru/openai/v1
IMAGE_API_KEY=

# Модели перебираются по порядку: первая, которая ответит, и рисует.
# Линейка gpt-image-1 выключена поставщиком 23.10.2026, актуальны 2.5/2.6.
# На gpt-image-2.5-flare генерация проверена вживую.
AI_PROVIDER_IMAGE_MODELS=gpt-image-2.5-flare,gpt-image-2.5-sunburst,gpt-image-2.6-flare,gpt-image-2
AI_PROVIDER_IMAGE_SIZE=1024x1024
AI_PROVIDER_IMAGE_QUALITY=medium

# Рисовать ли шевроны и кокарды крупно и разборчиво.
# По умолчанию false: крой и цвет формы МВД генератор передаёт верно,
# а вот шеврон подделывает — надпись «МВД» на нём выходит нечитаемой.
# При false форма всё равно узнаваемо полицейская, просто символика не
# попадает в фокус (вид со спины, с расстояния).
AI_IMAGE_SHOW_INSIGNIA=false

# Надпись, которую бот ставит на КАЖДУЮ сгенерированную картинку.
# Убирать её нельзя: без неё нарисованный кадр читается как
# фотография с места происшествия.
AI_IMAGE_LABEL=Иллюстрация · сгенерировано ИИ

# --- Подпись под постами (ссылки ведут на max.ru/<имя>) ---
CHANNEL_USERNAME=mvd
BOT_USERNAME=kindpolice_bot
CHANNEL_TITLE=Хороший полицейский

# --- Сбор ---
FETCH_LIMIT=10
FETCH_PER_SOURCE=20
MAX_NEWS_AGE_DAYS=7
POST_INTERVAL_MINUTES=120

# --- Веб-панель модерации (необязательна) ---
PANEL_USERNAME=
PANEL_PASSWORD=

# --- Логи ---
LOG_LEVEL=INFO
LOG_TO_FILE=true

# Аварийно: не проверять TLS-сертификат AI-провайдера.
# Включать ТОЛЬКО если провайдер отвечает «certificate has expired».
AI_PROVIDER_INSECURE_TLS=false
